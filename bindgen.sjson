
inputs = [
	"sqlite3.h"
	"sqlite3ext.h"
]

output_folder = "sqlite"
package_name = "sqlite"
// Only the direct bindings need a library import. Their Linux-only import
// lives in sqlite3_footer.odin, so sqlite3ext.odin gets no foreign import.
import_lib = ""

// sqlite3_open_v2 -> open_v2 (linked via link_prefix, so the symbol is unchanged)
remove_function_prefix = "sqlite3_"

// sqlite3_stmt -> Stmt, sqlite3_io_methods -> Io_Methods, ...
remove_type_prefix = "sqlite3_"
force_ada_case_types = true

// SQLITE_OK -> OK, SQLITE_LIMIT_SQL_LENGTH -> LIMIT_SQL_LENGTH, ...
remove_macro_prefix = "SQLITE_"

rename = {
	// The bare `sqlite3` struct is the database connection handle.
	"sqlite3" = "Connection"
	// Collapse the C int64 typedefs into Odin's builtin types.
	"sqlite3_int64" = "i64"
	"sqlite3_uint64" = "u64"
	"sqlite_int64" = "i64"
	"sqlite_uint64" = "u64"
}

// Gather the SQLITE_OPEN_* flag macros into a bit_set so open_v2() can be
// called like: open_v2(path, &db, {.READWRITE, .CREATE}, nil)
enumify_macros = {
	"SQLITE_OPEN_" = "Open_Flags"
}
bit_setify = {
	"Open_Flags" = "Open_Flag"
}

remove = [
	// C casts that cannot be expressed as Odin constants; both are
	// recreated (with identical values) in sqlite3_footer.odin.
	"SQLITE_STATIC"
	"SQLITE_TRANSIENT"
	// Legacy aliases of SQLITE_CARRAY_*; after prefix stripping they would
	// collide with the SQLITE_-prefixed versions (both sets have the same
	// values, so nothing is lost).
	"CARRAY_INT32"
	"CARRAY_INT64"
	"CARRAY_DOUBLE"
	"CARRAY_TEXT"
	"CARRAY_BLOB"
]

procedure_type_overrides = {
	// column_text/value_text return NUL-terminated UTF-8, i.e. a cstring,
	// consistent with errmsg(), column_name() and friends.
	"sqlite3_column_text" = "cstring"
	"sqlite3_value_text"  = "cstring"

	// Fundamental datatype codes (Datatype enum defined in the footer).
	"sqlite3_column_type"        = "Datatype"
	"sqlite3_value_type"         = "Datatype"
	"sqlite3_value_numeric_type" = "Datatype"

	// Misc typed parameters/returns.
	"sqlite3_open_v2.flags"          = "Open_Flags"
	"sqlite3_vtab_on_conflict"       = "Conflict_Resolution"
	"sqlite3_errstr.#0"              = "Result_Code"
	"sqlite3_set_errmsg.errcode"     = "Result_Code"
	"sqlite3_result_error_code.#1"   = "Result_Code"

	// Everything below returns an SQLite result code (Result_Code enum in
	// the footer). Procedures whose int return is a count, boolean, byte
	// size or comparison deliberately keep their plain integer type.
	"sqlite3_close"                 = "Result_Code"
	"sqlite3_close_v2"              = "Result_Code"
	"sqlite3_exec"                  = "Result_Code"
	"sqlite3_initialize"            = "Result_Code"
	"sqlite3_shutdown"              = "Result_Code"
	"sqlite3_os_init"               = "Result_Code"
	"sqlite3_os_end"                = "Result_Code"
	"sqlite3_config"                = "Result_Code"
	"sqlite3_db_config"             = "Result_Code"
	"sqlite3_extended_result_codes" = "Result_Code"
	"sqlite3_busy_handler"          = "Result_Code"
	"sqlite3_busy_timeout"          = "Result_Code"
	"sqlite3_setlk_timeout"         = "Result_Code"
	"sqlite3_get_table"             = "Result_Code"
	"sqlite3_set_authorizer"        = "Result_Code"
	"sqlite3_trace_v2"              = "Result_Code"
	"sqlite3_open"                  = "Result_Code"
	"sqlite3_open16"                = "Result_Code"
	"sqlite3_open_v2"               = "Result_Code"
	"sqlite3_set_errmsg"            = "Result_Code"
	"sqlite3_errcode"               = "Result_Code"
	"sqlite3_extended_errcode"      = "Result_Code"
	"sqlite3_prepare"               = "Result_Code"
	"sqlite3_prepare_v2"            = "Result_Code"
	"sqlite3_prepare_v3"            = "Result_Code"
	"sqlite3_prepare16"             = "Result_Code"
	"sqlite3_prepare16_v2"          = "Result_Code"
	"sqlite3_prepare16_v3"          = "Result_Code"
	"sqlite3_stmt_explain"          = "Result_Code"
	"sqlite3_bind_blob"             = "Result_Code"
	"sqlite3_bind_blob64"           = "Result_Code"
	"sqlite3_bind_double"           = "Result_Code"
	"sqlite3_bind_int"              = "Result_Code"
	"sqlite3_bind_int64"            = "Result_Code"
	"sqlite3_bind_null"             = "Result_Code"
	"sqlite3_bind_text"             = "Result_Code"
	"sqlite3_bind_text16"           = "Result_Code"
	"sqlite3_bind_text64"           = "Result_Code"
	"sqlite3_bind_value"            = "Result_Code"
	"sqlite3_bind_pointer"          = "Result_Code"
	"sqlite3_bind_zeroblob"         = "Result_Code"
	"sqlite3_bind_zeroblob64"       = "Result_Code"
	"sqlite3_clear_bindings"        = "Result_Code"
	"sqlite3_step"                  = "Result_Code"
	"sqlite3_finalize"              = "Result_Code"
	"sqlite3_reset"                 = "Result_Code"
	"sqlite3_create_function"        = "Result_Code"
	"sqlite3_create_function16"      = "Result_Code"
	"sqlite3_create_function_v2"     = "Result_Code"
	"sqlite3_create_window_function" = "Result_Code"
	"sqlite3_transfer_bindings"     = "Result_Code"
	"sqlite3_global_recover"        = "Result_Code"
	"sqlite3_memory_alarm"          = "Result_Code"
	"sqlite3_set_clientdata"        = "Result_Code"
	"sqlite3_result_zeroblob64"     = "Result_Code"
	"sqlite3_create_collation"      = "Result_Code"
	"sqlite3_create_collation_v2"   = "Result_Code"
	"sqlite3_create_collation16"    = "Result_Code"
	"sqlite3_collation_needed"      = "Result_Code"
	"sqlite3_collation_needed16"    = "Result_Code"
	"sqlite3_win32_set_directory"   = "Result_Code"
	"sqlite3_win32_set_directory8"  = "Result_Code"
	"sqlite3_win32_set_directory16" = "Result_Code"
	"sqlite3_autovacuum_pages"      = "Result_Code"
	"sqlite3_enable_shared_cache"   = "Result_Code"
	"sqlite3_db_release_memory"     = "Result_Code"
	"sqlite3_table_column_metadata" = "Result_Code"
	"sqlite3_load_extension"        = "Result_Code"
	"sqlite3_enable_load_extension" = "Result_Code"
	"sqlite3_auto_extension"        = "Result_Code"
	"sqlite3_create_module"         = "Result_Code"
	"sqlite3_create_module_v2"      = "Result_Code"
	"sqlite3_drop_modules"          = "Result_Code"
	"sqlite3_declare_vtab"          = "Result_Code"
	"sqlite3_overload_function"     = "Result_Code"
	"sqlite3_blob_open"             = "Result_Code"
	"sqlite3_blob_reopen"           = "Result_Code"
	"sqlite3_blob_close"            = "Result_Code"
	"sqlite3_blob_read"             = "Result_Code"
	"sqlite3_blob_write"            = "Result_Code"
	"sqlite3_vfs_register"          = "Result_Code"
	"sqlite3_vfs_unregister"        = "Result_Code"
	"sqlite3_mutex_try"             = "Result_Code"
	"sqlite3_file_control"          = "Result_Code"
	"sqlite3_keyword_name"          = "Result_Code"
	"sqlite3_str_errcode"           = "Result_Code"
	"sqlite3_status"                = "Result_Code"
	"sqlite3_status64"              = "Result_Code"
	"sqlite3_db_status"             = "Result_Code"
	"sqlite3_db_status64"           = "Result_Code"
	"sqlite3_backup_step"           = "Result_Code"
	"sqlite3_backup_finish"         = "Result_Code"
	"sqlite3_unlock_notify"         = "Result_Code"
	"sqlite3_wal_autocheckpoint"    = "Result_Code"
	"sqlite3_wal_checkpoint"        = "Result_Code"
	"sqlite3_wal_checkpoint_v2"     = "Result_Code"
	"sqlite3_vtab_config"           = "Result_Code"
	"sqlite3_vtab_in_first"         = "Result_Code"
	"sqlite3_vtab_in_next"          = "Result_Code"
	"sqlite3_vtab_rhs_value"        = "Result_Code"
	"sqlite3_db_cacheflush"         = "Result_Code"
	"sqlite3_snapshot_get"          = "Result_Code"
	"sqlite3_snapshot_open"         = "Result_Code"
	"sqlite3_snapshot_recover"      = "Result_Code"
	"sqlite3_deserialize"           = "Result_Code"
	"sqlite3_carray_bind"           = "Result_Code"
	"sqlite3_carray_bind_v2"        = "Result_Code"
	"sqlite3_rtree_geometry_callback" = "Result_Code"
	"sqlite3_rtree_query_callback"    = "Result_Code"

	// Extension API table: match the direct bindings above. Parameters in
	// sqlite3ext.h are unnamed, so use their zero-based positions.
	"sqlite3_api_routines.column_text" = "cstring"
	"sqlite3_api_routines.value_text" = "cstring"
	"sqlite3_api_routines.column_type" = "Datatype"
	"sqlite3_api_routines.value_type" = "Datatype"
	"sqlite3_api_routines.value_numeric_type" = "Datatype"
	"sqlite3_api_routines.vtab_on_conflict" = "Conflict_Resolution"
